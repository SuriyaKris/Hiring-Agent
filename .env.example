# ══════════════════════════════════════════════════════════════
# 4CECloud AI Hiring Agent — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────
# Primary: "gemini" (Google AI Studio) | Fallback: "groq" | Optional: "openai"
LLM_PROVIDER=gemini

# Gemini (Google AI Studio — https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.5-flash-lite

# Groq (FREE tier fallback — get key at https://console.groq.com)
# Free limits: 14,400 requests/day, 500,000 tokens/minute
GROQ_API_KEY=gsk_...
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional paid tier — https://platform.openai.com)
OPENAI_API_KEY=sk-...
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# ── Candidate Data Source ─────────────────────────────────────
# POC  (free): leave blank → agent uses realistic mock data
# Prod (paid): set Apollo API key → real people search
APOLLO_API_KEY=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
APOLLO_REDIRECT_URI=

# ── Optional: SerpAPI (Phase 2 — X-Ray LinkedIn search) ──────
# Free tier: 100 searches/month — get at https://serpapi.com
SERPAPI_KEY=

# ── Optional: Proxycurl (Phase 2 — LinkedIn profile fetch) ───
# Pay-per-use: $0.01/profile — get at https://nubela.co/proxycurl
PROXYCURL_API_KEY=

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# POC:  sqlite+aiosqlite:///./hiring_agent.db  (no setup needed)
# Prod: postgresql+asyncpg://user:pass@host:5432/hiring_agent
DATABASE_URL=sqlite+aiosqlite:///./hiring_agent.db

# ── LangChain tracing (optional, free tier) ──────────────────
# Sign up at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hiring-agent-v2
